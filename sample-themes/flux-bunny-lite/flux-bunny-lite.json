  , "scmGraph.historyItemHoverDefaultLabelBackground"     : "#008700"
  , "scmGraph.historyItemHoverDefaultLabelForeground"     : "#e4e4e4"
  , "scmGraph.foreground2"                                : "#872f87"
  , "scmGraph.foreground3"                                : "#d75f00"
  , "scmGraph.foreground4"                                : "#af005f"
  , "scmGraph.foreground5"                                : "#005f87"
  , "scmGraph.historyItemHoverAdditionsForeground"        : "#008700"
