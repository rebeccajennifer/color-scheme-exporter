  , "diffEditorGutter.insertedLineBackground"             : "#008700"
  , "diffEditorOverview.insertedForeground"               : "#008700"
  , "diffEditor.insertedTextBorder"                       : "#00000000"

  , "diffEditor.removedLineBackground"                    : "#d75f8710"
  , "diffEditor.removedTextBackground"                    : "#d75f8720"
