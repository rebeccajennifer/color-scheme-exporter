{
  "$schema"     : "vscode://schemas/color-theme"

, "colors":
  {
  //____________________________________________________________________
  // GENERAL
  //____________________________________________________________________
    "foreground"                                          : "#262626"
  , "editor.background"                                   : "#e4e4e4"
  , "editor.foreground"                                   : "#262626"

  //____________________________________________________________________
  // TERMINAL
  //____________________________________________________________________
  , "terminal.background"                                 : "#e4e4e4"
  , "terminal.foreground"                                 : "#262626"
  , "terminalCursor.background"                           : "#e4e4e4"
  , "terminalCursor.foreground"                           : "#008700"
  //____________________________________________________________________
  , "terminal.ansiBlack"                                  : "#121212"
  , "terminal.ansiRed"                                    : "#af005f"
  , "terminal.ansiGreen"                                  : "#008700"
  , "terminal.ansiYellow"                                 : "#d75f00"
  , "terminal.ansiBlue"                                   : "#005f87"
  , "terminal.ansiMagenta"                                : "#872f87"
  , "terminal.ansiCyan"                                   : "#5f8787"
  , "terminal.ansiWhite"                                  : "#878787"
  //____________________________________________________________________
  , "terminal.ansiBrightBlack"                            : "#878787"
  , "terminal.ansiBrightRed"                              : "#d75f87"
  , "terminal.ansiBrightGreen"                            : "#008700"
  , "terminal.ansiBrightYellow"                           : "#d78700"
  , "terminal.ansiBrightBlue"                             : "#0087af"
  , "terminal.ansiBrightMagenta"                          : "#875f87"
  , "terminal.ansiBrightCyan"                             : "#005f5f"
  , "terminal.ansiBrightWhite"                            : "#afafaf"

  // E.g. Background of hyperlink on hover in terminal
  , "terminal.hoverHighlightBackground"                   : "#875f8760"

  // Dot left of command prompt
  , "terminalCommandDecoration.defaultBackground"         : "#5f8787"
  , "terminalCommandDecoration.successBackground"         : "#008700"
  , "terminalCommandDecoration.errorBackground"           : "#d75f87"

  //____________________________________________________________________
  // BORDERS
  //____________________________________________________________________
  , "titleBar.border"                                     : "#26262620"
  , "statusBar.border"                                    : "#26262620"
  , "activityBar.border"                                  : "#26262620"

  , "sideBar.border"                                      : "#26262620"
  , "tab.border"                                          : "#e4e4e4"
  , "peekView.border"                                     : "#5fa2a2"

  // Border of focused element, e.g. active pane
  , "focusBorder"                                         : "#5fa2a2"

  // Border dividing panel from editor
  , "panel.border"                                        : "#26262620"

  // Border under panel title
  , "panelTitle.border"                                   : "#26262620"

  // E.g. Debug configuration selection
  , "dropdown.border"                                     : "#26262620"

  // Border of text input fields, e.g. command palette, search
  , "input.border"                                        : "#26262620"

  // Vertical line at certain character width in editor
  , "editorRuler.foreground"                              : "#26262620"

  // Transparent
  , "editorStickyScroll.border"                           : "#00000000"
  , "panelStickyScroll.border"                            : "#00000000"

  //____________________________________________________________________
  // TITLE BAR - Main window title bar
  //____________________________________________________________________
  , "titleBar.activeBackground"                           : "#f8f8f8"
  , "titleBar.activeForeground"                           : "#303030"

  , "titleBar.inactiveBackground"                         : "#e4e4e4"
  , "titleBar.inactiveForeground"                         : "#262626"

  //____________________________________________________________________
  // STATUS BAR - Bottom of window
  //____________________________________________________________________
  , "statusBar.background"                                : "#f8f8f8"
  , "statusBar.foreground"                                : "#303030"

  , "statusBar.noFolderBackground"                        : "#af5faf"
  , "statusBar.noFolderForeground"                        : "default"
  , "statusBar.noFolderBorder"                            : "default"

  , "statusBarItem.remoteBackground"                      : "#008700"
  , "statusBarItem.remoteForeground"                      : "#eeeeee"

  , "statusBarItem.activeBackground"                      : "default"
  , "statusBarItem.errorHoverBackground"                  : "default"
  , "statusBarItem.errorHoverForeground"                  : "default"
  , "statusBarItem.hoverBackground"                       : "default"
  , "statusBarItem.hoverForeground"                       : "default"
  , "statusBar.focusBorder"                               : "default"

  //____________________________________________________________________
  // ACTIVITY BAR - Left of window
  //____________________________________________________________________
  , "activityBar.foreground"                              : "#303030"
  , "activityBar.background"                              : "#eeeeee"
  , "activityBar.activeBackground"                        : "#5fa2a2"
  , "activityBar.activeBorder"                            : "#303030"
  , "activityBarBadge.background"                         : "#008700"
  , "activityBarBadge.foreground"                         : "#eeeeee"
  , "activityErrorBadge.background"                       : "#d75f87"
  , "activityErrorBadge.foreground"                       : "#eeeeee"
  , "activityWarningBadge.background"                     : "#d78700"
  , "activityWarningBadge.foreground"                     : "#eeeeee"

  //____________________________________________________________________
  // SIDEBAR - Project explorer, etc.
  //____________________________________________________________________
  , "sideBar.background"                                  : "#eeeeee" // lighter?
  , "sideBar.foreground"                                  : "#262626"
  , "sideBarStickyScroll.shadow"                          : "#121212"

  , "sideBarTitle.background"                             : "#e4e4e4"
  , "sideBarTitle.foreground"                             : "#303030"
  , "sideBarSectionHeader.background"                     : "#26262610"
  , "sideBarSectionHeader.foreground"                     : "#303030"

  , "list.activeSelectionBackground"                      : "#5fa2a2"
  , "list.activeSelectionForeground"                      : "#303030"
  , "list.inactiveSelectionBackground"                    : "#26262610"
  , "list.inactiveSelectionForeground"                    : "#262626"
  , "list.activeSelectionIconForeground"                  : "#262626"
  , "list.hoverBackground"                                : "#5f8ca2"

  // Drag and drop files
  , "list.dropBackground"                                 : "#af5faf"
  , "list.dropBetweenBackground"                          : "#af5faf"

  , "list.highlightForeground"                            : "#008700"
  , "list.focusBackground"                                : "#5f8ca2"
  , "list.focusForeground"                                : "#303030"
  , "list.invalidItemForeground"                          : "#d75f87"

  //____________________________________________________________________
  // COMMAND PALETTE - Drop down when pressing Ctrl+P or Ctrl+Shift+P
  //____________________________________________________________________

  // Keyboard shortcut indicator in drop down command palette
  , "keybindingLabel.background"                          : "#26262610"
  , "keybindingLabel.foreground"                          : "#262626"

  // E.g. 'other commands', 'recently opened ' in command palette
  , "pickerGroup.foreground"                              : "#0087af"

  //____________________________________________________________________
  // MINIMAP - Mini version of code on right of window
  //____________________________________________________________________
  , "minimap.background"                                  : "#eeeeee"
  , "minimap.selectionHighlight"                          : "#5f878780"
  , "minimap.findMatchHighlight"                          : "#004d5fc0"
  , "minimapGutter.addedBackground"                       : "#008700"
  , "minimapGutter.deletedBackground"                     : "#d75f87"
  , "minimapGutter.modifiedBackground"                    : "#d75f00"
  , "minimapSlider.background"                            : "#26262660"
  , "minimapSlider.hoverBackground"                       : "#26262680"
  , "minimapSlider.activeBackground"                      : "#262626c0"

  //____________________________________________________________________
  // SCROLL BAR
  //____________________________________________________________________
  , "scrollbar.background"                                : "#eeeeee"
  , "scrollbarSlider.background"                          : "#26262660"
  , "scrollbarSlider.hoverBackground"                     : "#26262680"
  , "scrollbarSlider.activeBackground"                    : "#262626a0"

  , "notebookScrollbarSlider.background"                  : "#26262660"
  , "notebookScrollbarSlider.activeBackground"            : "#26262680"
  , "notebookScrollbarSlider.hoverBackground"             : "#262626a0"

  //____________________________________________________________________
  // OVERVIEW RULER - Vertical bar to right of minimap
  //____________________________________________________________________
   , "editorOverviewRuler.addedForeground"                : "#008700"
   , "editorOverviewRuler.modifiedForeground"             : "#d75f00"
   , "editorOverviewRuler.deletedForeground"              : "#af005f"
   , "editorOverviewRuler.wordHighlightForeground"        : "#26262620"
   , "editorOverviewRuler.wordHighlightTextForeground"    : "#004d5f"
   , "editorOverviewRuler.findMatchForeground"            : "#004d5f"

  //____________________________________________________________________
  // GUTTER - Line numbers, etc
  //____________________________________________________________________
  , "editorLineNumber.activeForeground"                   : "#d75f87"
  , "editorLineNumber.foreground"                         : "#878787"

  //____________________________________________________________________
  // TABS
  //____________________________________________________________________
  , "tab.activeBackground"                                : "#e4e4e4"
  , "tab.activeForeground"                                : "#262626"
  , "tab.inactiveBackground"                              : "#26262610"
  , "tab.inactiveForeground"                              : "#26262680"
  , "tab.unfocusedActiveForeground"                       : "#005f87"
  , "tab.unfocusedInactiveForeground"                     : "#878787"

  // Dead space to right of tabs
  , "editorGroupHeader.tabsBackground"                    : "#e4e4e4"

  //____________________________________________________________________
  // HIGHLIGHTING AND SELECTION
  //____________________________________________________________________
  , "editorCursor.background"                             : "#e4e4e4"
  , "editorCursor.foreground"                             : "#008700"

  // Current line highlight
  , "editor.lineHighlightBackground"                      : "#eeeeeeE0"

  // Text selection in editor, e.g. click and drag, Vim visual selection
  , "editor.selectionBackground"                          : "#26262620"
  // This property is overwritten
  , "editor.selectionForeground"                          : "#e4e4e4"

  // Selected text in text input fields
  , "selection.background"                                : "#5f8ca2e0"

  // Occurrences of selected text in file
  // Needed for visual selection in vim
  , "editor.selectionHighlightBackground"                 : "#26262610"

  // Occurrences of word under cursor
  // Needs to be transparent so selectionHighlightBackground shows
  // when word under cursor is selected
  , "editor.wordHighlightTextBackground"                  : "#26262620"

  // Occurrences of a symbol under cursor
  , "editor.wordHighlightBackground"                      : "#26262610"

  // Highlight of search results from search bar and Vim find command
  , "editor.findMatchHighlightBackground"                 : "#5f8ca2e0"

  // Background of currently selected search result
  // Looks like this is getting overwritten by
  // "editor.findMatchHighlightBackground"
  // Appears on the first search of a workspace session but disappears
  // after that
  , "editor.findMatchBackground"                          : "#5f8ca2e0"

  //____________________________________________________________________
  // LINKS
  //____________________________________________________________________
  , "textLink.foreground"                                 : "#0087af"
  , "textLink.activeForeground"                           : "#005f87"

  //____________________________________________________________________
  // TEXT INPUT FIELDS
  //____________________________________________________________________
  , "input.background"                                    : "#eeeeee40"
  , "input.foreground"                                    : "#262626"
  , "input.placeholderForeground"                         : "#878787"

  // E.g. Commit message entry, command palette
  , "editor.placeholder.foreground"                       : "#878787"

  // E.g. Match case button in search
  , "inputOption.activeBackground"                        : "#5fa2a2"
  , "inputOption.activeForeground"                        : "#262626"
  , "inputOption.activeBorder"                            : "#26262610"

  // Dropdown for command field
