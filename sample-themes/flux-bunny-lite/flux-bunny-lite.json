  , "peekViewEditor.matchHighlightBackground"             : "#af5fafe0"
  , "peekViewResult.matchHighlightBackground"             : "#5f8ca2e0"

  , "peekViewEditorStickyScroll.background"               : "#5f8ca2"
  , "peekViewEditorStickyScrollGutter.background"         : "#5f8ca2"

  , "peekViewTitleLabel.foreground"                       : "#262626"
  , "peekViewResult.fileForeground"                       : "#262626"
  , "peekViewResult.selectionBackground"                  : "#af5faf"
  , "peekViewResult.selectionForeground"                  : "#262626"

  // Peek View line number background
  //, "peekViewEditorGutter.background"                     :"#eeeeee"

   // Text color of header in settings
  , "settings.headerForeground"                           : "#005f5f"

  //____________________________________________________________________
  // DROPDOWN
  //____________________________________________________________________
  , "dropdown.background"                                 : "#eeeeee"
  , "dropdown.foreground"                                 : "#262626"
  , "dropdown.listBackground"                             : "#e4e4e4"

  //____________________________________________________________________
  // PANELS
  //____________________________________________________________________
  , "panel.background"                                    : "#e4e4e4"

  , "panelTitle.activeForeground"                         : "#303030"
  , "panelTitle.inactiveForeground"                       : "#26262680"

  // Underline of active panel title - shows which panel is active
  , "panelTitle.activeBorder"                             : "#5fa2a2"
  //, "panelSectionHeader.background"                       : "#008700"
  //, "panelTitleBadge.foreground"                          : "#e4e4e4"

  //____________________________________________________________________
  // BUTTONS & CHECKBOXES
  //____________________________________________________________________
  , "button.background"                                   : "#5fa2a2"
  , "button.foreground"                                   : "#262626"
  , "button.hoverBackground"                              : "#5f8ca2"
  , "button.border"                                       : "#00000000"

  , "button.secondaryBackground"                          : "#af5faf"
