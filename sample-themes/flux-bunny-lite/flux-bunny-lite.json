  , "editorStickyScroll.shadow"                           : "#121212"
  , "panelStickyScroll.background"                        : "#eeeeee"
  , "panelStickyScroll.shadow"                            : "#121212"
  , "sideBarStickyScroll.background"                      : "#eeeeee"

