  // Vertical bar in gutter showing where line was added
  , "editorGutter.addedBackground"                        : "#008700"
  // After staging - vertical bar in gutter where line was added
  , "editorGutter.addedSecondaryBackground"               : "#008700"

  , "editorGutter.modifiedBackground"                     : "#d75f00"
  , "editorGutter.modifiedSecondaryBackground"            : "#d75f00"

