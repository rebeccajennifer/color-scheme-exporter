  , "gitDecoration.untrackedResourceForeground"           : "#872f87"
  , "gitDecoration.deletedResourceForeground"             : "#d75f87"
  , "gitDecoration.renamedResourceForeground"             : "#d78700"
  , "gitDecoration.conflictingResourceForeground"         : "#d75f87"
  , "gitDecoration.stageDeletedResourceForeground"        : "#d75f87"
