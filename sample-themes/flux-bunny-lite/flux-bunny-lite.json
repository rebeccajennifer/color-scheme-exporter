  , "editorWidget.border"                                 : "#26262610"
  , "editorSuggestWidget.background"                      : "#eeeeee"
  , "editorSuggestWidget.foreground"                      : "#262626"
  , "editorSuggestWidget.border"                          : "#26262610"

