  , "extensionButton.prominentBackground"                 : "default"
  , "extensionButton.prominentForeground"                 : "default"
  , "extensionButton.prominentHoverBackground"            : "default"
  , "agentsNewSessionButton.background"                   : "default"
  , "agentsNewSessionButton.foreground"                   : "default"
  , "agentsNewSessionButton.hoverBackground"              : "default"
  , "agentsNewSessionButton.border"                       : "#00000000"
  , "agentsUpdateButton.downloadedBackground"             : "default"
  , "agentsUpdateButton.downloadingBackground"            : "default"


