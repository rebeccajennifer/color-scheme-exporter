  // Breakpoint dot
  , "debugIcon.breakpointForeground"                      : "#d75f87"
  , "debugIcon.breakpointDisabledForeground"              : "#d75f8760"

  // Breakpoint arrow when stopped
  , "debugIcon.breakpointCurrentStackframeForeground"     : "#008700"

  , "debugToolBar.background"                             : "#eeeeee"
  , "debugIcon.startForeground"                           : "#008700"
  , "debugIcon.stopForeground"                            : "#af005f"
  , "debugIcon.stepIntoForeground"                        : "#005f87"
  , "debugIcon.stepOverForeground"                        : "#005f87"
  , "debugIcon.stepOutForeground"                         : "#005f87"
  , "debugIcon.continueForeground"                        : "#872f87"
  , "debugIcon.pauseForeground"                           : "#872f87"
  , "debugIcon.restartForeground"                         : "#5f8787"

  , "editor.inlineValuesBackground"                       : "#eeeeee"
  , "editor.inlineValuesForeground"                       : "#d75f00"
  , "editor.stackFrameHighlightBackground"                : "#eeeeee"
  , "statusBar.debuggingBackground"                       : "#d78700"
  , "statusBar.debuggingForeground"                       : "#eeeeee"
  , "statusBar.debuggingBorder"                           : "#00000000"

  // Debug exception
  , "debugExceptionWidget.border"                         : "#d75f87"
