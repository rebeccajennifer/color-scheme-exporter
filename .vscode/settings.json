{ "sarif-viewer.connectToGithubCodeScanning"       : "off",

  //____________________________________________________________________
  // JSON FORMATTER - Extension 'FracturedJson' by j-brooke
  //____________________________________________________________________
  "fracturedjsonvsc.TableCommaPlacement"           : "AfterPadding",  // Align ,
  "fracturedjsonvsc.ColonBeforePropNamePadding"    : false,  // Align :

  // Add a space after character
  "fracturedjsonvsc.ColonPadding"                  : true,  // :
  "fracturedjsonvsc.SimpleBracketPadding"          : true,  // [
  "fracturedjsonvsc.CommaPadding"                  : true,  // ,
  "fracturedjsonvsc.NestedBracketPadding"          : true,

  // Space before comment
  // Note: If both CommaPadding and CommentPadding are true, two
  // spaces are inserted after a comma and before a comment
  "fracturedjsonvsc.CommentPadding"                : true,

  //--------------------------------------------------------------------
  // Property: "fracturedjsonvsc.AllowTableSegments"
  // Value   : true
  // Meaning : Sub sections in table are lined up separately:
  //--------------------------------------------------------------------
  //"files.associations": {
  //    "*makefile": "makefile",
  //    "*.yapf"   : "ini"     ,

  //    ".clang-format"        : "yaml"          ,
  //    "*.{a80,z80,asm,inc,s}": "asm-collection",

  //    "*.{list,lis}": "asm-collection-list",
  //    "*.gpr"       : "ada"
  //},
  //--------------------------------------------------------------------
  // All properties line up across comments and blank lines
  "fracturedjsonvsc.AllowTableSegments"            : false,

  //--------------------------------------------------------------------
  // These settings have no effect when AllowTableSegments is false
  //--------------------------------------------------------------------
  "fracturedjsonvsc.SplitTableSegmentsAtBlankLines": true,
  "fracturedjsonvsc.SplitTableSegmentsAtComments"  : true,
  //--------------------------------------------------------------------

  "fracturedjsonvsc.PreserveBlankLines"            : true,
  "fracturedjsonvsc.CollapseOpeningBrackets"       : true,
  "fracturedjsonvsc.CollapseClosingBrackets"       : false,

  // -1  For both properties indicates only one element per line
  "fracturedjsonvsc.MaxInlineComplexity"           : -1,
  "fracturedjsonvsc.MaxCompactArrayComplexity"     : -1,

  // Align decimal points across consecutive properties with decimal values
  // E.g.: "property_0": 42.0,
  //       "property_1":  3.14,
  "fracturedjsonvsc.NumberListAlignment"           : "Decimal",

  "fracturedjsonvsc.MaxPropNamePadding"            : 200,
  "fracturedjsonvsc.MaxTotalLineLength"            : 200,

  //--------------------------------------------------------------------
  // Unsure of these settings

  "fracturedjsonvsc.AllowTrailingCommas"           : false,
  "fracturedjsonvsc.CommentPolicyForJSONC"         : "Preserve",
  "fracturedjsonvsc.CommentPolicyForJSON"          : "TreatAsError",
  "fracturedjsonvsc.StringWidthPolicy"             : "EastAsianFullWidth",

  "fracturedjsonvsc.MaxTableRowComplexity"         : 2,
  "fracturedjsonvsc.AlwaysExpandDepth"             : -1,
  "fracturedjsonvsc.MinCompactArrayRowItems"       : 3,

  "cSpell.words"                                   : [
    "cout"      ,
    "konsole"   ,
    "Konsole"   ,
    "KONSOLE"   ,
    "Mintty"    ,
    "MINTTY"    ,
    "Stackframe"
  ],
  "cSpell.ignoreWords"                             : [
    "unpulled"
  ]
}
